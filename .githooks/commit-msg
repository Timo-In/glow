#!/bin/sh
# Conventional Commits 本地拦截门禁 (兼容 Mac / Linux / Windows)
# 自动生成自 git-plus 插件体系

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || dirname "$HOOK_DIR")"
COMMIT_MSG_FILE="$1"
FIRST_LINE="$(head -n 1 "$COMMIT_MSG_FILE" 2>/dev/null || true)"

# ANSI 终端颜色高亮
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
BOLD='\033[1m'
NC='\033[0m'

# 1. 自动放行合并/回退/打标签等自动提交
if echo "$FIRST_LINE" | grep -qE '^(Merge|Revert|fixup!|squash!)'; then
    exit 0
fi

# 2. 检查并按需自动触发依赖安装 (仅首次缺失时调用)
ENSURE_SCRIPT="$HOOK_DIR/ensure-linter.sh"
ENSURE_BAT="$HOOK_DIR/ensure-linter.bat"
if ! command -v pommitlint >/dev/null 2>&1 && \
   ! command -v pommitlint.exe >/dev/null 2>&1 && \
   ! [ -x "$HOME/.local/bin/pommitlint" ] && \
   ! [ -x "$HOME/.local/bin/pommitlint.exe" ] && \
   ! [ -x "$HOOK_DIR/bin/pommitlint" ] && \
   ! [ -x "$HOOK_DIR/bin/pommitlint.exe" ] && \
   ! command -v commitlint >/dev/null 2>&1 && \
   ! command -v commitlint.cmd >/dev/null 2>&1; then
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*|CYGWIN*|Windows_NT*)
            if [ -f "$ENSURE_BAT" ]; then
                cmd.exe //c "$ENSURE_BAT" 2>&1 || sh "$ENSURE_SCRIPT" 2>&1 || true
            else
                sh "$ENSURE_SCRIPT" 2>&1 || true
            fi
            ;;
        *)
            if [ -x "$ENSURE_SCRIPT" ]; then
                sh "$ENSURE_SCRIPT" 2>&1 || true
            fi
            ;;
    esac
fi

# 3. 定位可用 Linter 二进制 (区分系统与扩展名)
LINTER_CMD=""
if command -v pommitlint >/dev/null 2>&1; then
    LINTER_CMD="pommitlint"
elif [ -x "/usr/local/bin/pommitlint" ]; then
    LINTER_CMD="/usr/local/bin/pommitlint"
elif [ -x "$HOME/.local/bin/pommitlint" ]; then
    LINTER_CMD="$HOME/.local/bin/pommitlint"
elif [ -x "$HOOK_DIR/bin/pommitlint" ]; then
    LINTER_CMD="$HOOK_DIR/bin/pommitlint"
elif command -v pommitlint.exe >/dev/null 2>&1; then
    LINTER_CMD="pommitlint.exe"
elif [ -x "$HOOK_DIR/bin/pommitlint.exe" ]; then
    LINTER_CMD="$HOOK_DIR/bin/pommitlint.exe"
elif command -v commitlint >/dev/null 2>&1; then
    LINTER_CMD="commitlint"
elif [ -x "/usr/local/bin/commitlint" ]; then
    LINTER_CMD="/usr/local/bin/commitlint"
elif command -v commitlint.cmd >/dev/null 2>&1; then
    LINTER_CMD="commitlint.cmd"
fi

# 打印统一的规范约束说明与修复命令
print_guidelines_and_cmd() {
    LINTER_NAME="$1"
    printf "\n${RED}================================================================${NC}\n"
    if [ -n "$LINTER_NAME" ]; then
        printf "${RED}${BOLD}[本地拦截] Commit 提交信息未通过 %s 规范校验！${NC}\n" "$LINTER_NAME"
    else
        printf "${RED}${BOLD}[本地拦截] Commit 提交信息不符合服务端严格规范！${NC}\n"
    fi
    printf "${YELLOW}当前提交标题: ${BOLD}%s${NC}\n\n" "$FIRST_LINE"

    printf "${CYAN}服务端对齐约束:${NC}\n"
    printf "  1. 冒号后面首字母必须是 ${GREEN}[小写字母]${NC} (例如: feat: add... 不能是 feat: Add...)\n"
    printf "  2. 结尾绝对不能带有英文句号 ${RED}'.'${NC}\n"
    printf "  3. 正确格式参考: ${YELLOW}<type>(<scope>): <description>${NC}\n"
    printf "  4. 常用规范类型: ${GREEN}feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert${NC}\n\n"

    # 生成规范化建议命令 (自动去掉末尾句号并小写首字母)
    SUGGESTION="$FIRST_LINE"
    SUGGESTION="${SUGGESTION%.}"
    if echo "$SUGGESTION" | grep -q ":"; then
        TYPE_PART="${SUGGESTION%%:*}"
        DESC_PART="${SUGGESTION#*: }"
        TYPE_LOWER="$(echo "$TYPE_PART" | tr '[:upper:]' '[:lower:]')"
        DESC_FIRST="$(echo "$DESC_PART" | cut -c1 | tr '[:upper:]' '[:lower:]')"
        DESC_REST="$(echo "$DESC_PART" | cut -c2-)"
        SUGGESTION="${TYPE_LOWER}: ${DESC_FIRST}${DESC_REST}"
    fi

    printf "${CYAN}💡 规范修改后重新提交:${NC}\n"
    printf "  ${GREEN}git commit -m \"%s\"${NC}\n" "$SUGGESTION"
    printf "${RED}================================================================${NC}\n\n"
}

# 4. 执行自检拦截
if [ -n "$LINTER_CMD" ]; then
    if echo "$LINTER_CMD" | grep -q "pommitlint"; then
        if ! "$LINTER_CMD" lint --file "$COMMIT_MSG_FILE"; then
            print_guidelines_and_cmd "pommitlint"
            exit 1
        fi
        exit 0
    else
        if ! "$LINTER_CMD" --edit "$COMMIT_MSG_FILE"; then
            print_guidelines_and_cmd "commitlint"
            exit 1
        fi
        exit 0
    fi
fi

# 5. Fallback: 严格正则表达式本地轻量校验
PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_.-]+\))?: [a-z0-9].*[^.]$"
if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
    print_guidelines_and_cmd ""
    exit 1
fi
